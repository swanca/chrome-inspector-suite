{
  "manifest_version": 3,
  "name": "Page to Markdown - Copy Any Web Page as Markdown",
  "version": "1.4.0",
  "description": "Convert the readable part of any page into clean Markdown. 100% local - no tracking, no data collected.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Page to Markdown",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}
