{
  "manifest_version": 3,
  "name": "Link Extractor - Export All Page Links to CSV",
  "version": "2.0.0",
  "description": "Extract, filter and export every link on a page as CSV. 100% local - no tracking, no data collected.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Link Extractor",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
