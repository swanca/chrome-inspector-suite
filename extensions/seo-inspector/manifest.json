{
  "manifest_version": 3,
  "name": "SEO Inspector - On-Page SEO, Meta Tags & Open Graph Audit",
  "version": "2.0.0",
  "description": "Instant on-page SEO, Open Graph and accessibility audit. 100% local - no account, no tracking, no data collected.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SEO Inspector",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
