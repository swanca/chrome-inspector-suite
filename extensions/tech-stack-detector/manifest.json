{
  "manifest_version": 3,
  "name": "Tech Stack Detector - Frameworks, CMS & Libraries",
  "version": "2.0.0",
  "description": "Identify the frameworks, CMS and libraries behind any page. 100% local - no tracking, no data collected.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tech Stack Detector",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
