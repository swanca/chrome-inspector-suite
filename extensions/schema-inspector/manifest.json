{
  "manifest_version": 3,
  "name": "Schema Inspector - JSON-LD & Microdata Structured Data",
  "version": "2.0.0",
  "description": "Parse JSON-LD and Microdata, then check the properties each type requires. 100% local - no data collected.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Schema Inspector",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
